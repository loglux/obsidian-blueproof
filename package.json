{
	"name": "blueproof",
	"version": "0.4.7",
	"description": "Spelling, grammar and style checking for Obsidian in many languages, LaTeX-aware.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check": "npm run lint && npm run build"
	},
	"keywords": [],
	"author": "Vladislav Sorokin",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/nspell": "^2.1.6",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"fasttext.wasm.js": "1.0.0",
		"nspell": "^2.1.5"
	}
}
